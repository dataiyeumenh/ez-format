# ─── AI Mode ─────────────────────────────────────────────────────────────────
# disabled  → không dùng AI (mặc định an toàn)
# mock      → trả về dữ liệu giả, dùng để test
# ollama legacy đã bị chặn; mọi inference phải đi qua AI Local Gateway.
AI_MODE=disabled

# Model Ollama sẽ dùng (phải đã pull sẵn: ollama pull qwen2.5:7b)
AI_MODEL=qwen2.5:7b

# URL Ollama (mặc định localhost, không cần đổi nếu chạy cùng máy)
OLLAMA_BASE_URL=http://localhost:11434
# Host private/non-public khác localhost phải được allowlist rõ ràng.
# AI_PRIVATE_LOCAL_HOST_ALLOWLIST=192.168.1.20,10.147.17.5
AI_GATEWAY_MAX_CONCURRENCY=2
AI_GATEWAY_QUEUE_TIMEOUT_SECONDS=0.1

# ─── Remote AI mapping gateway (converter) ───────────────────────────────────
# Khi AI chạy qua ngrok/ZeroTier, converter chỉ nên chờ ngắn rồi fallback heuristic.
AI_PROVIDER=disabled
# AI_BASE_URL=https://your-ngrok-domain/v1/misa/suggest-mapping
# AI_TOKEN=your-secret-token
AI_MAPPING_TIMEOUT_SECONDS=15
AI_MAPPING_TIMEOUT_CAP_SECONDS=20
AI_REQUIRED=false
# Chỉ bật cho test/dev API cũ; production phải giữ false.
ALLOW_LEGACY_ROW_EXPORT=false

# ─── CORS ────────────────────────────────────────────────────────────────────
# Danh sách origin được phép gọi API, cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://127.0.0.1:5173

# Company workspace + MISA master data. Values must match the Node backend.
CONVERSION_CONTEXT_SECRET=replace-with-the-backend-conversion-context-secret
CONVERTER_SERVICE_TOKEN=replace-with-the-backend-converter-service-token
INTERNAL_SERVICE_TOKEN_REQUIRED=true
MAX_UPLOAD_BYTES=20971520
NODE_INTERNAL_API_URL=http://127.0.0.1:5000/api/internal
MASTER_DATA_CONTEXT_TIMEOUT_SECONDS=15
MASTER_DATA_CONTEXT_CACHE_SECONDS=300
MAPPING_PROFILE_TIMEOUT_SECONDS=15
LOCAL_MAPPING_OWNER_SCOPE=local:default

# Student assistant rollback gates. Existing converter routes remain available
# when these flags are false.
STUDENT_ASSISTANT_ENABLED=false
STUDENT_FILE_EXPLAIN_ENABLED=false
STUDENT_FILE_QA_ENABLED=false
STUDENT_ACCOUNTING_MAP_ENABLED=false
STUDENT_RECONCILIATION_ENABLED=false
STUDENT_INTERNSHIP_ENABLED=false
STUDENT_UPLOAD_RETENTION_SECONDS=86400
STUDENT_UPLOAD_CLEANUP_INTERVAL_SECONDS=300
STUDENT_MAX_FILE_BYTES=20971520
STUDENT_ANALYZE_LIMIT_PER_15_MINUTES=5
STUDENT_QUESTION_LIMIT_PER_15_MINUTES=60
STUDENT_ANONYMIZATION_LIMIT_PER_15_MINUTES=20
STUDENT_REPORT_LIMIT_PER_15_MINUTES=10
STUDENT_EXPORT_LIMIT_PER_15_MINUTES=10

# Smart voucher reconstruction (Phase 3)
VOUCHER_RECONSTRUCTION_ENABLED=false
RECONSTRUCTION_STORE_PROVIDER=filesystem
RECONSTRUCTION_STORE_TTL_HOURS=24
RECONSTRUCTION_MAX_FILE_BYTES=31457280
RECONSTRUCTION_MAX_ROWS=50000
RECONSTRUCTION_MAX_CELLS=3000000
RECONSTRUCTION_MAX_DRAFTS=10000
RECONSTRUCTION_ANALYZE_LIMIT_PER_15_MINUTES=5
RECONSTRUCTION_EXPORT_LIMIT_PER_15_MINUTES=20
RECONSTRUCTION_STORE_DIR=
# Production: use a TLS Redis URL instead of Render's ephemeral filesystem.
RECONSTRUCTION_REDIS_URL=
RECONSTRUCTION_REDIS_PREFIX=ezformat:production:reconstruction
RECONSTRUCTION_ENVIRONMENT=development
RECONSTRUCTION_NOTIFY_NODE=true
RECONSTRUCTION_NODE_REQUIRED=false
RECONSTRUCTION_SHADOW_MODE=false
AI_RECONSTRUCTION_BASE_URL=
AI_RECONSTRUCTION_TIMEOUT_SECONDS=20
AI_RECONSTRUCTION_PROMPT_VERSION=phase3-v1
AI_RECONSTRUCTION_CACHE_TTL_SECONDS=3600
AI_RECONSTRUCTION_CACHE_MAX_ENTRIES=500

# Accounting operations assistance. Disabled until each production gate passes.
FEATURE_MAPPING_PROFILE_V2=false
FEATURE_ANOMALY_DETECTION=false
FEATURE_BULK_CORRECTION=false
FEATURE_RECONCILIATION=false
FEATURE_ACCOUNTING_ASSISTANT=false
FEATURE_AI_EXPLANATION=false
OPERATION_SESSION_DIR=
OPERATION_SESSION_TTL_SECONDS=3600
# Development-only. Production must keep this false and use signed context.
ALLOW_UNAUTHENTICATED_LOCAL_OPERATIONS=false
RECONCILIATION_MAX_FILE_BYTES=31457280
RECONCILIATION_MAX_ROWS=50000
RECONCILIATION_MAX_COLUMNS=500
RECONCILIATION_MAX_COMPARISON_FILES=2
# Required in production; use a different value from AI/JWT tokens.
EVIDENCE_PACKET_SECRET=
AI_ACCOUNTING_ASSISTANT_BASE_URL=
