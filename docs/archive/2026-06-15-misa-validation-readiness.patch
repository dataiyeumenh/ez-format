+                    )
+                )
+
+        if not account_pattern_warning_added:
+            unusual_account = _first_unusual_account(row, target_headers)
+            if unusual_account:
+                account_pattern_warning_added = True
+                account_header, account_value = unusual_account
+                collector.add(
