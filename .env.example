# Student assistant rollback gates. Keep all false until each phase is enabled.
STUDENT_ASSISTANT_ENABLED=false
STUDENT_PRIVACY_RETENTION_ENABLED=true
STUDENT_FILE_EXPLAIN_ENABLED=false
STUDENT_FILE_QA_ENABLED=false
STUDENT_ACCOUNTING_MAP_ENABLED=false
STUDENT_RECONCILIATION_ENABLED=false
STUDENT_INTERNSHIP_ENABLED=false
STUDENT_PRIVACY_MIGRATION_MODE=off

# Trusted MISA templates. Relative paths resolve from the converter directory.
MISA_TEMPLATE_DIR=fixtures/templates
MISA_TEMPLATE_MANIFEST_PATH=config/misa-template-manifest.json
# Current committed templates are partner-supplied, not claimed official.
MISA_TEMPLATE_ACCEPTED_TRUST_LEVELS=partner_supplied

# Production rejects these example values. Generate distinct high-entropy values
# of at least 32 characters in the deployment secret manager.
JWT_SECRET=replace-with-a-distinct-high-entropy-bearer-secret
CONVERSION_CONTEXT_SECRET=replace-with-a-distinct-high-entropy-context-secret
CONVERTER_SERVICE_TOKEN=replace-with-a-distinct-high-entropy-internal-secret
# Required in production when Student Assistant is enabled. Use at least 32 characters
# with at least 12 distinct characters; placeholders/defaults are rejected. Keep
# distinct from CONVERSION_CONTEXT_SECRET and CONVERTER_SERVICE_TOKEN.
STUDENT_ANONYMIZATION_SECRET=replace-with-a-distinct-random-secret-of-at-least-32-characters

# Temporary raw student uploads are capped at 24 hours.
STUDENT_UPLOAD_RETENTION_SECONDS=86400
STUDENT_MAX_FILE_BYTES=20971520
STUDENT_ANALYZE_LIMIT_PER_15_MINUTES=5
STUDENT_QUESTION_LIMIT_PER_15_MINUTES=60
STUDENT_ANONYMIZATION_LIMIT_PER_15_MINUTES=20
STUDENT_REPORT_LIMIT_PER_15_MINUTES=10
STUDENT_EXPORT_LIMIT_PER_15_MINUTES=10

# Accounting operations and import repair stay fail-closed until enabled.
FEATURE_MAPPING_PROFILE_V2=false
FEATURE_ANOMALY_DETECTION=false
FEATURE_BULK_CORRECTION=false
FEATURE_RECONCILIATION=false
FEATURE_ACCOUNTING_ASSISTANT=false
FEATURE_AI_EXPLANATION=false
MISA_IMPORT_REPAIR_ENABLED=false
