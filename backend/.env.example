PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ezformat
JWT_SECRET=dev_change_me_in_production
JWT_EXPIRE=30d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional seed credentials (npm run seed)
SEED_ADMIN_EMAIL=admin@ezformat.local
SEED_ADMIN_PASSWORD=admin123456

# payOS production checkout
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
PAYOS_WEBHOOK_URL=http://localhost:5000/api/payments/payos-webhook

# Google Identity Services
GOOGLE_CLIENT_ID=

# Company workspace + MISA master data
MASTER_DATA_WORKSPACES_ENABLED=true
CONVERSION_CONTEXT_SECRET=replace-with-a-long-random-secret
CONVERTER_SERVICE_TOKEN=replace-with-another-long-random-secret
CONVERTER_INTERNAL_URL=http://127.0.0.1:8000
CONVERTER_TIMEOUT_MS=60000
