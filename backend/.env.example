PORT=5000
# Local standalone Mongo supports non-payment development only. PayOS settlement needs
# Atlas, a replica set, or a sharded deployment; startup verifies the connected topology.
MONGO_URI=mongodb://127.0.0.1:27017/ezformat
# Production rejects this example. Generate a distinct high-entropy value of at
# least 32 characters in the deployment secret manager.
JWT_SECRET=replace-with-a-distinct-high-entropy-bearer-secret
JWT_EXPIRE=30d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional seed credentials (npm run seed)
SEED_ADMIN_EMAIL=admin@ezformat.local
SEED_ADMIN_PASSWORD=admin123456

# payOS production checkout
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
PAYOS_WEBHOOK_URL=http://localhost:5000/api/payments/payos-webhook
# Production PayOS contract: set all three PAYOS_* secrets and use a transactional MONGO_URI.
# A standalone MongoDB deployment makes startup fail instead of accepting settlement traffic.

# Optional real-Mongo payment integration test. Use a disposable replica-set database ending
# in -test or _test; never point this at production data.
PAYMENT_REPLICA_SET_TEST_URI=
# Optional real MongoDB/GridFS round-trip test. Use a disposable database ending
# in -test or _test; never point this at production data.
GRIDFS_INTEGRATION_TEST_URI=

# Google Identity Services
GOOGLE_CLIENT_ID=

# Company workspace + MISA master data
MASTER_DATA_WORKSPACES_ENABLED=true
VOUCHER_RECONSTRUCTION_ENABLED=false
RECONSTRUCTION_STORE_TTL_HOURS=24
RECONSTRUCTION_CREATE_LIMIT_PER_15_MINUTES=20
RECONSTRUCTION_SHADOW_MODE=false
# Optional comma-separated workspace ObjectIds for a controlled beta.
RECONSTRUCTION_BETA_WORKSPACE_IDS=

# Accounting operations are opt-in. Migration never runs unless explicitly selected.
FEATURE_MAPPING_PROFILE_V2=false
FEATURE_ANOMALY_DETECTION=false
FEATURE_BULK_CORRECTION=false
FEATURE_RECONCILIATION=false
FEATURE_ACCOUNTING_ASSISTANT=false
FEATURE_AI_EXPLANATION=false
ACCOUNTING_COMPARISON_FILE_LIMIT=2
ACCOUNTING_RAW_TTL_MINUTES=60
ACCOUNTING_MAX_ROWS_PER_FILE=50000
MAPPING_PROFILE_V2_MIGRATION_MODE=off
# Student product remains opt-in. Safety retention stays enabled while data may exist.
STUDENT_ASSISTANT_ENABLED=false
STUDENT_PRIVACY_RETENTION_ENABLED=true
STUDENT_PRIVACY_MIGRATION_MODE=off
ARTIFACT_LIFECYCLE_MIGRATION_MODE=off
# Artifact lifecycle HMAC secrets must each contain at least 32 bytes. Rotation
# is two releases: first deploy the current key alone to persist its Mongo
# canary; only a later release may add it as previous with a new active key.
# Missing canaries, reused IDs, or shortened horizons fail startup closed.
ARTIFACT_LIFECYCLE_HMAC_ACTIVE_KEY_ID=v1
ARTIFACT_LIFECYCLE_HMAC_SECRET=
# Bootstrap with {} and a blank horizon. Keep prior keys through the documented
# rolling horizon after the subsequent multi-key deployment.
ARTIFACT_LIFECYCLE_HMAC_PREVIOUS_KEYS={}
ARTIFACT_LIFECYCLE_HMAC_ROTATION_HORIZON=

# Final-reviewed MISA import repair. Records and workbook bytes remain in MongoDB/GridFS.
MISA_IMPORT_REPAIR_ENABLED=false
MISA_IMPORT_REPAIR_SWEEP_INTERVAL_SECONDS=300
MISA_IMPORT_REPAIR_SWEEP_BATCH_SIZE=100
# Production rejects these examples. Generate distinct high-entropy values of at
# least 32 characters; share only the matching values with the converter.
CONVERSION_CONTEXT_SECRET=replace-with-a-distinct-high-entropy-context-secret
CONVERTER_SERVICE_TOKEN=replace-with-a-distinct-high-entropy-internal-secret
CONVERTER_INTERNAL_URL=http://127.0.0.1:8000
CONVERTER_PUBLIC_PROXY_ENABLED=false
CONVERTER_GATEWAY_USAGE_READY=false
# Applied after internal authentication and before raw/JSON artifact parsing.
CONVERTER_INTERNAL_WRITE_RATE_LIMIT=120
CONVERTER_INTERNAL_RATE_LIMIT_MAX_KEYS=10000
CONVERTER_INTERNAL_RATE_LIMIT_WINDOW_MS=60000
CONVERTER_ARTIFACT_STORAGE_DRIVER=mongodb
CONVERTER_MONGODB_GRIDFS_BUCKET=conversion_artifacts
# Shared Node/converter bound: only unsigned safe decimal integers are accepted.
# Syntax such as 1e6, hex, signs, or whitespace uses 64 MiB; valid values above
# 512 MiB are capped. Authenticated legacy JSON adds one base64 payload plus
# 64 KiB metadata overhead. Keep both services identical during rollout.
CONVERTER_ARTIFACT_MAX_BYTES=67108864
CONVERTER_ARTIFACT_SWEEP_INTERVAL_SECONDS=300
CONVERTER_ARTIFACT_SWEEP_MAX_FILES=100
CONVERTER_TIMEOUT_MS=60000
