PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ezformat
JWT_SECRET=dev_change_me_in_production
JWT_EXPIRE=30d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional seed credentials (npm run seed)
SEED_ADMIN_EMAIL=admin@ezformat.local
SEED_ADMIN_PASSWORD=admin123456

# payOS production checkout
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
PAYOS_WEBHOOK_URL=http://localhost:5000/api/payments/payos-webhook

# Google Identity Services
GOOGLE_CLIENT_ID=

# Company workspace + MISA master data
MASTER_DATA_WORKSPACES_ENABLED=true
VOUCHER_RECONSTRUCTION_ENABLED=false
RECONSTRUCTION_STORE_TTL_HOURS=24
RECONSTRUCTION_CREATE_LIMIT_PER_15_MINUTES=20
RECONSTRUCTION_SHADOW_MODE=false
# Optional comma-separated workspace ObjectIds for a controlled beta.
RECONSTRUCTION_BETA_WORKSPACE_IDS=
# Accounting operations are opt-in until their production gates pass.
FEATURE_MAPPING_PROFILE_V2=false
FEATURE_ANOMALY_DETECTION=false
FEATURE_BULK_CORRECTION=false
FEATURE_RECONCILIATION=false
FEATURE_ACCOUNTING_ASSISTANT=false
FEATURE_AI_EXPLANATION=false
ACCOUNTING_COMPARISON_FILE_LIMIT=2
ACCOUNTING_RAW_TTL_MINUTES=60
ACCOUNTING_MAX_ROWS_PER_FILE=50000
# off | dry-run | apply. Migration only creates V2 drafts and never edits V1.
MAPPING_PROFILE_V2_MIGRATION_MODE=off
# Dedicated HS256 secret. Production never falls back to JWT_SECRET.
CONVERSION_CONTEXT_SECRET=replace-with-a-long-random-secret
# Development/test compatibility only; production ignores this flag.
CONVERSION_CONTEXT_ALLOW_JWT_SECRET_FALLBACK=false
CONVERTER_INTERNAL_URL=http://127.0.0.1:8000
# HTTP is allowed only for loopback development/test with this explicit opt-in.
CONVERTER_ALLOW_INSECURE_LOCALHOST=true
CONVERTER_SERVICE_TOKEN=replace-with-a-long-random-secret
CONVERTER_PUBLIC_PROXY_ENABLED=true
# Task 2 enables this only after entitlement and atomic usage charging are ready.
CONVERTER_GATEWAY_USAGE_READY=false
CONVERTER_MAX_FILE_BYTES=20971520
CONVERTER_TIMEOUT_MS=120000
CONVERTER_MAX_OUTPUT_BYTES=67108864
CONVERTER_ANALYZE_LIMIT_PER_10_MINUTES=10
CONVERTER_OPERATION_LIMIT_PER_MINUTE=120
CONVERTER_EXPORT_LIMIT_PER_10_MINUTES=10
CONVERSION_USAGE_MODE=charge_on_export
CONVERTER_ARTIFACT_TTL_SECONDS=3600
CONVERTER_ARTIFACT_MAX_BYTES=67108864
CONVERTER_ARTIFACT_MAX_FILES=1000
CONVERTER_ARTIFACT_SWEEP_MAX_FILES=200
CONVERTER_ARTIFACT_SWEEP_INTERVAL_SECONDS=300
CONVERTER_ARTIFACT_TOMBSTONE_TTL_SECONDS=604800
# Development/test: local + explicit opt-in. Production must use s3.
CONVERTER_ARTIFACT_STORAGE_DRIVER=local
CONVERTER_ALLOW_LOCAL_ARTIFACT_STORAGE=true
CONVERTER_SESSION_ARTIFACT_DIR=
# Production requires shared S3-compatible storage regardless of this legacy flag.
CONVERTER_OBJECT_STORAGE_REQUIRED=false
CONVERTER_S3_ENDPOINT=
CONVERTER_S3_REGION=
CONVERTER_S3_BUCKET=
CONVERTER_S3_ACCESS_KEY_ID=
CONVERTER_S3_SECRET_ACCESS_KEY=
CONVERTER_S3_SESSION_TOKEN=
CONVERTER_S3_ALLOW_INSECURE_LOCALHOST=false
